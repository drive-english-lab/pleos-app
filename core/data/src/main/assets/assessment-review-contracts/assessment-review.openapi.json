    "/v2/assessment-reviews/{target_id}": {
      "get": {
        "operationId": "readAssessmentReview",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "service_contract_version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "const": 1
            }
          },
          {
            "name": "lookup",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "review",
                "attempt"
              ]
            }
          },
          {
            "name": "profile_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "privacy_epoch",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
