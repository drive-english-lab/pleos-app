      "required": [
        "headline_placement_confirmed",
        "headline_observations",
        "independent_origin_groups",
        "independent_origin_count",
        "independence_status",
        "latest_original_published_at",
        "as_of",
        "policy_revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "independence_status": {
                "type": "string",
                "const": "pending"
              }
            },
            "required": [
              "independence_status"
            ]
          },
          "then": {
            "properties": {
              "independent_origin_count": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "headline_placement_confirmed": {
                "const": true
              }
            },
            "required": [
              "headline_placement_confirmed"
            ]
          },
          "then": {
            "properties": {
              "headline_observations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/HeadlineObservation"
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "IssueView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "type": "string",
          "format": "uuid"
        },
        "issue_revision": {
          "type": "integer",
          "minimum": 1
        },
        "representative_article_id": {
          "type": "string",
          "format": "uuid"
        },
        "member_article_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "article": {
          "$ref": "#/$defs/ArticleDiscoveryView"
        },
        "evidence": {
          "$ref": "#/$defs/IssueEvidence"
        },
        "issue_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "rank_policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "issue_id",
        "issue_revision",
        "representative_article_id",
        "member_article_ids",
        "article",
        "evidence",
        "issue_as_of",
        "rank_policy_revision"
      ]
    },
    "CatalogViewItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/ArticleDiscoveryView"
        },
        {
          "$ref": "#/$defs/IssueView"
        }
      ]
    },
    "CatalogViewResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_view_contract_version": {
          "type": "integer",
          "const": 1
        },
        "profile_context": {
          "$ref": "#/$defs/Source6CommonProfileContext"
        },
        "view": {
          "type": "string",
          "enum": [
            "interests",
            "issues"
          ]
        },
        "category_filter_id": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "technology",
                "science",
                "business",
                "world",
                "environment",
                "culture"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "snapshot_revision": {
          "type": "integer",
          "minimum": 1
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 1
        },
        "view_policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category_config": {
          "$ref": "#/$defs/PreparationCategoryPublicProjection"
        },
        "collection_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "view_state": {
          "type": "string",
          "enum": [
            "ready",
            "empty",
            "pending",
            "failed"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogViewItem"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "catalog_view_contract_version",
        "profile_context",
        "view",
        "category_filter_id",
        "snapshot_id",
        "snapshot_revision",
        "catalog_revision",
        "view_policy_revision",
        "category_config",
        "collection_as_of",
        "published_as_of",
        "issue_as_of",
        "view_state",
        "reason",
        "items",
        "next_cursor"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "view": {
                "type": "string",
                "const": "issues"
              }
            },
            "required": [
              "view"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/IssueView"
                },
                "minItems": 0,
                "maxItems": 50
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "type": "string",
                "const": "interests"
              }
            },
            "required": [
              "view"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ArticleDiscoveryView"
                },
                "minItems": 0,
                "maxItems": 50
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view_state": {
                "type": "string",
                "const": "ready"
              }
            },
            "required": [
              "view_state"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view_state": {
                "type": "string",
                "const": "empty"
              }
            },
            "required": [
              "view_state"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ArticleDiscoveryView"
                },
                "minItems": 0,
                "maxItems": 0
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "retryable": {
              "type": "boolean"
            },
            "current_version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "retryable",
            "current_version"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
