  "paths": {
    "/v1/content/sentence-manifests/{script_id}": {
      "get": {
        "operationId": "readSentenceManifest",
        "security": [],
        "parameters": [
          {
            "name": "script_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "source_kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "legacy_bundle",
                "prepared_components"
              ]
            }
          },
          {
            "name": "bundle_id",
            "in": "query",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "name": "material_generation_id",
            "in": "query",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "name": "segments_version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "script_text_hash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored data only; no output/completion grant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "review.schema.json#/$defs/SentenceManifestResponse"
                }
              }
            }
          },
          "403": {
            "description": "Typed failure; original operation is preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "review.schema.json#/$defs/ErrorEnvelope"
                }
