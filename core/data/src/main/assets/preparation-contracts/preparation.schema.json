      },
      "required": [
        "kind",
        "script_id",
        "script_hash",
        "manifest_id",
        "manifest_version",
        "manifest_hash",
        "phase",
        "segment_id",
        "segment_index",
        "resume_from",
        "play_intent",
        "pause_reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "type": "string",
                "const": "article_offer"
              }
            },
            "required": [
              "phase"
