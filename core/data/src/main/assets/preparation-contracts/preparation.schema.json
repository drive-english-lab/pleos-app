        "record_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "record_id"
      ],
      "description": "listening references an unfinished checkpoint; practice references an unfinished lesson OR a completed lesson with pending_feedback_attempt_id. Reading a result is not a presentation ACK. Completion/ACK clears only a pointer still targeting that lesson."
    },
