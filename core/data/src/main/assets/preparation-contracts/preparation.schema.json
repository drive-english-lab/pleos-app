    "ComponentRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "outline",
            "facts",
            "summary",
            "practice",
            "language_basics",
            "main_original",
            "main_briefing",
            "followup",
            "sentence_detail"
          ]
        },
        "base_script_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "original_full",
                "briefing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "band": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "basic",
                "intermediate",
                "advanced"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "en",
                "ko"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "target_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "followup_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "en_summary",
                "ko_summary",
                "ko_translation"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "base_script_id",
        "format",
        "band",
        "language",
        "target_span",
        "followup_kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "main_original"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "band": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "sentence_detail"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "target_span": {
                "$ref": "#/$defs/TargetSpan"
              }
            }
          },
          "else": {
            "properties": {
              "target_span": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "followup"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "base_script_id": {
                "type": "string",
                "format": "uuid"
              },
              "format": {
                "type": "string",
                "enum": [
                  "original_full",
                  "briefing"
