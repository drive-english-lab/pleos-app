    "/v1/profile/speaking-records": {
      "get": {
        "operationId": "listSpeakingRecords",
        "summary": "Read automatic cards with separate snapshot cursor.",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "personal-data.openapi.json#/components/parameters/InstallationId"
          },
          {
            "name": "client_privacy_epoch",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Expected history epoch; verified binding remains the access authority."
          },
          {
            "name": "visibility",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "visible",
                "hidden"
              ],
              "default": "visible"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
