          "if": {
            "properties": {
              "visibility_filter": {
                "const": "visible"
              }
            },
            "required": [
              "visibility_filter"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "visibility": {
                      "properties": {
                        "hidden": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "visibility": {
                      "properties": {
                        "hidden": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
